# ============================================
# Configuración del backend - Equipo Murciélago
# ============================================
# Copia este archivo a .env y rellena con valores reales:
#   copy .env.example .env
# ============================================

# --- Base de datos PostgreSQL ---
# Desarrollo local. Ejecuta `python configure_local_db.py` para validar la
# contraseña real de PostgreSQL y guardarla en .env sin escribirla en el chat.
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_PASSWORD@127.0.0.1:5432/murcielago

# Producción (Azure) - comentado por ahora:
# DATABASE_URL=postgresql+asyncpg://usuario:password@servidor.postgres.database.azure.com:5432/murcielago_db?ssl=require

# --- Seguridad ---
# OBLIGATORIO: genera una clave propia (la API no arranca con una débil o publicada):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_genera_una_con_el_comando_de_arriba
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALUMNO_TOKEN_MINUTES=120

# Código que la escuela entrega a cada docente para poder crear su cuenta.
# Elige uno largo y no lo subas a GitHub. Vacío = nadie puede registrarse.
CODIGO_INVITACION_DOCENTES=

# Bloqueo de una cuenta tras intentos fallidos seguidos, y tope de juegos de IA por hora.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=5
IA_MAX_JUEGOS_POR_HORA=20

# --- IA (Gemini) ---
# Placeholder: la clave real se obtiene en Google AI Studio
GEMINI_API_KEY=tu-clave-de-gemini-aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_LAST_RESORT_MODEL=gemini-3.5-flash-lite
# Créditos mensuales compartidos por análisis de material y generación de juegos.
IA_GENERACIONES_MENSUALES_MAX=15
