# ============================================
# Configuración del backend - Equipo Murciélago
# ============================================
# Copia este archivo a .env y rellena con valores reales:
#   copy .env.example .env
# ============================================

# --- Base de datos PostgreSQL ---
# Desarrollo local. Ejecuta `python configure_local_db.py` para validar la
# contraseña real de PostgreSQL y guardarla en .env sin escribirla en el chat.
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_PASSWORD@127.0.0.1:5432/murcielago

# Producción (Azure) - comentado por ahora:
# DATABASE_URL=postgresql+asyncpg://usuario:password@servidor.postgres.database.azure.com:5432/murcielago_db?ssl=require

# --- Seguridad ---
# OBLIGATORIO: genera una clave propia (la API no arranca con una débil o publicada):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_genera_una_con_el_comando_de_arriba
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALUMNO_TOKEN_MINUTES=120

# Código que la escuela entrega a cada docente para poder crear su cuenta.
# Elige uno largo y no lo subas a GitHub. Vacío = nadie puede registrarse.
CODIGO_INVITACION_DOCENTES=

# Bloqueo de una cuenta tras intentos fallidos seguidos, y tope de juegos de IA por hora.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=5
IA_MAX_JUEGOS_POR_HORA=20

# --- IA (Gemini) ---
# Placeholder: la clave real se obtiene en Google AI Studio
# Proveedor de IA: "gemini" (real) o "demo" (juegos y clases de ejemplo, sin clave ni créditos; útil
# para presentar el proyecto sin internet). En modo demo el panel docente muestra un aviso.
IA_PROVEEDOR=gemini
GEMINI_API_KEY=tu-clave-de-gemini-aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_LAST_RESORT_MODEL=gemini-3.5-flash-lite
# Créditos mensuales compartidos por análisis de material y generación de juegos.
IA_GENERACIONES_MENSUALES_MAX=15
# Límite diario del plan Gratis (los demás planes están en app/core/planes.py).
IA_GENERACIONES_DIARIAS_MAX=3
# Solo para ESTIMAR el costo en el panel de administración (dólares por millón de tokens y tipo de
# cambio). Revisa la página de precios de Gemini: el precio de gemini-3.8-flash sube el 1 ene 2027.
IA_PRECIO_ENTRADA_USD_MTOK=1.50
IA_PRECIO_SALIDA_USD_MTOK=7.50
IA_TIPO_CAMBIO_MXN=18.5

# --- Publicación (ver docs/despliegue_ionos.md) ---
# Direcciones desde las que el navegador puede usar la API, separadas por comas.
# En producción: la dirección pública, por ejemplo https://mupi.mx,https://www.mupi.mx
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
# true SOLO si la API corre detrás de nginx en el mismo servidor (así se lee la IP real del visitante).
CONFIAR_EN_PROXY=false
# Dirección pública de la página (para el enlace de "recuperar contraseña").
URL_FRONTEND=http://localhost:5173
RECUPERACION_MINUTOS=30
# Versión del aviso de privacidad y los términos que acepta cada docente al registrarse.
VERSION_TERMINOS=2026-11

# --- Correo para "recuperar contraseña" (SMTP) ---
# Sin SMTP_HOST, en local el enlace se escribe en la terminal del backend. En producción es obligatorio.
# Usa el servidor y puerto que indique tu proveedor de correo (en IONOS aparecen en el panel del buzón).
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
